# ---- Database ----
DATABASE_URL=postgresql+psycopg2://rootcause:rootcause@localhost:5432/rootcause

# ---- Redis (Celery broker, optional - see README for asyncio-only mode) ----
REDIS_URL=redis://localhost:6379/0

# ---- Local LLM (Ollama) - NO hosted/cloud LLM is ever called ----
OLLAMA_BASE_URL=http://localhost:11434
# Per-task model overrides. All default to qwen2.5. Point these at different
# locally-pulled models if you want a smaller model for cheap classification
# tasks and a larger one for hypothesis generation - everything still routes
# to the same local Ollama daemon, there is no hosted fallback tier.
OLLAMA_MODEL_SUMMARY=qwen2.5
OLLAMA_MODEL_REDACTION=qwen2.5
OLLAMA_MODEL_CLASSIFICATION=qwen2.5
OLLAMA_MODEL_HYPOTHESIS=qwen2.5
OLLAMA_MODEL_POSTMORTEM=qwen2.5

# ---- Demo / fixture mode ----
# When true, all integration clients (Prometheus/Loki/K8s/GitLab/Slack)
# return canned fixture data reproducing the OOMKilled demo scenario instead
# of making real network calls.
DEMO_MODE=true

# ---- GitLab (Change Agent) ----
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=changeme
GITLAB_PROJECT_ID=changeme

# ---- Prometheus / Loki ----
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# ---- Kubernetes ----
# Respects the standard KUBECONFIG env var if already set in your shell;
# this is just the pydantic-settings default/override for it.
KUBECONFIG=~/.kube/config
# Matches infra/k3d/sample-app/k8s/namespace.yaml. Change if your cluster
# deploys the workload under investigation into a different namespace.
K8S_NAMESPACE=demo

# ---- Slack ----
SLACK_BOT_TOKEN=xoxb-changeme
SLACK_CHANNEL=#incidents
# From your Slack app's "Basic Information" -> "App Credentials" page.
# Used to verify X-Slack-Signature / X-Slack-Request-Timestamp on
# POST /api/v1/slack/investigate. See infra/slack/README.md.
SLACK_SIGNING_SECRET=changeme

# ---- Alertmanager (informational only; no outbound calls use this) ----
ALERTMANAGER_URL=http://localhost:9093

# ---- Auth: OIDC (human/UI users) ----
# No fake/local IdP is bundled -- point these at a real IdP (Keycloak,
# Okta, Azure AD, ...). See docs/auth-setup.md for a worked Keycloak setup.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
# If blank, defaults to {OIDC_ISSUER_URL}/.well-known/jwks.json
OIDC_JWKS_URL=
# Claim (in the decoded JWT) carrying the role(s)/group(s) to map to
# viewer/engineer/admin. See docs/auth-setup.md for exact claim shape.
OIDC_ROLES_CLAIM=roles
OIDC_JWKS_CACHE_SECONDS=3600

# ---- Auth: API keys (service-to-service: Alertmanager webhook, CI) ----
# Header name accepted in addition to "Authorization: Bearer <key>".
API_KEY_HEADER=X-API-Key

# ---- Auth: dev/demo escape hatch ----
# When true AND DEMO_MODE=true, unauthenticated requests are treated as an
# implicit admin actor so the existing demo/docker-compose flows work
# without an IdP or API keys. MUST be false (or simply irrelevant, since
# DEMO_MODE should also be false) in any real deployment.
AUTH_ALLOW_ANONYMOUS_IN_DEMO=true

# ---- Environment-scoped integration URLs (optional overrides) ----
# When set, MetricsAgent/LogAgent/InfrastructureAgent/ChangeAgent use the
# override matching the Incident's `environment` field instead of the
# global PROMETHEUS_URL/LOKI_URL/KUBECONFIG/K8S_NAMESPACE/GITLAB_PROJECT_ID
# above, so a staging investigation can never touch production
# infrastructure by accident. Uncomment/set as many as apply; anything
# unset falls back to the corresponding global variable.
# PROMETHEUS_URL_PRODUCTION=
# PROMETHEUS_URL_STAGING=
# LOKI_URL_PRODUCTION=
# LOKI_URL_STAGING=
# KUBECONFIG_PRODUCTION=
# KUBECONFIG_STAGING=
# K8S_NAMESPACE_PRODUCTION=
# K8S_NAMESPACE_STAGING=
# GITLAB_PROJECT_ID_PRODUCTION=
# GITLAB_PROJECT_ID_STAGING=

# ---- Vault (secrets management) ----
# If VAULT_ADDR is unset, app/secrets.py falls back to the plain env vars
# above (GITLAB_TOKEN, SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, DATABASE_URL)
# and logs a warning. See docs/vault-setup.md for the mounts/policies to
# provision in a real Vault server.
VAULT_ADDR=
# Prefer AppRole (VAULT_ROLE_ID/VAULT_SECRET_ID) over a static token in any
# real deployment; a static token is fine for local Vault dev servers.
VAULT_TOKEN=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH=rootcause
VAULT_DATABASE_MOUNT=database
VAULT_DATABASE_ROLE=rootcause-app
VAULT_SECRET_CACHE_SECONDS=300

# ---- Data retention ----
# How long Evidence rows are kept before backend/scripts/cleanup_expired_evidence.py
# (run as a cron / k8s CronJob) deletes them.
EVIDENCE_RETENTION_DAYS=90
